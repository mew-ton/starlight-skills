{
  "name": "starlight-skills-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "preview": "turbo preview --filter=starlight-skills-docs",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check . --write",
    "release": "pnpm publish -r --access public"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "^2.30.0",
    "turbo": "^2.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1"
}
