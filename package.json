{
  "name": "starlight-skills-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/starlight-skills && npm run build --workspace=docs",
    "build:plugin": "npm run build --workspace=packages/starlight-skills",
    "build:docs": "npm run build --workspace=docs",
    "dev": "npm run dev --workspace=docs",
    "preview": "npm run preview --workspace=docs"
  }
}
