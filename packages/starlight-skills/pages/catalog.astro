---
/**
 * Skills Catalog page — injected by the starlight-skills plugin.
 *
 * Lists all skills found in the Starlight project as a browsable table.
 * Rendered at the path configured via `catalogPath` (default: /skills-catalog).
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { skills } from 'virtual:starlight-skills/data';
---

<StarlightPage
  frontmatter={{
    title: 'Skills Catalog',
    description: 'All AI skills available in this repository.',
  }}
>
  <p>
    The following skills are available from this repository. Install them with:
  </p>
  <pre><code>npx skills add &lt;repository&gt;</code></pre>

  {skills.length === 0 ? (
    <p><em>No skills found. Add <code>skill: true</code> to the frontmatter of a documentation page.</em></p>
  ) : (
    <table>
      <thead>
        <tr>
          <th>Skill</th>
          <th>Category</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {skills.map((skill) => (
          <tr>
            <td>
              <a href={skill.url}>
                <code>{skill.name}</code>
              </a>
            </td>
            <td>{skill.category || '—'}</td>
            <td>{skill.description || '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</StarlightPage>
