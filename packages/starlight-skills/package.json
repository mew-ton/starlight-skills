{
  "name": "starlight-skills",
  "version": "0.2.0",
  "description": "A Starlight plugin that turns your documentation into AI-installable skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/mew-ton/starlight-skills",
    "directory": "./packages/starlight-skills"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src/components",
    "virtual.d.ts"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "keywords": [
    "astro",
    "starlight",
    "starlight-plugin",
    "skills",
    "ai",
    "claude",
    "withastro"
  ],
  "peerDependencies": {
    "@astrojs/starlight": ">=0.21.0",
    "astro": ">=4.0.0"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.5"
  },
  "devDependencies": {
    "@astrojs/starlight": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "astro": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "author": "mew-ton",
  "license": "MIT"
}
